{
  "title": "Zenoh-native storage (ros2/** -> InfluxDB)",
  "uid": "zenoh-storage",
  "schemaVersion": 39,
  "time": {"from": "now-15m", "to": "now"},
  "refresh": "5s",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Ingestion rate (points / 10s, per key)",
      "datasource": {"type": "influxdb", "uid": "InfluxDB-zenoh"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 0},
      "targets": [{
        "rawQuery": true,
        "query": "SELECT count(\"value\") FROM /.*/ WHERE $timeFilter GROUP BY time(10s), \"_measurement\" fill(0)",
        "resultFormat": "time_series"
      }]
    },
    {
      "id": 2, "type": "stat", "title": "Total stored points (15m)",
      "datasource": {"type": "influxdb", "uid": "InfluxDB-zenoh"},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 9},
      "targets": [{
        "rawQuery": true,
        "query": "SELECT count(\"value\") FROM /.*/ WHERE $timeFilter",
        "resultFormat": "time_series"
      }]
    }
  ]
}
